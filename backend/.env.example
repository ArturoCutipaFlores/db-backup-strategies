# ------------------------------------------------------------------
# Copia este archivo como .env (NUNCA subas .env a GitHub).
#   cp .env.example .env
# ------------------------------------------------------------------

# Cadena de conexión de PostgreSQL.
# - Neon (producción): cópiala desde el panel de Neon -> "Connection string".
#   Ejemplo:
#   DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Local con docker-compose (ya viene configurada en docker-compose.yml):
#   (el postgres de docker-compose se publica en el puerto 5433 del host)
#   DATABASE_URL=postgresql://tasks:tasks_password@localhost:5433/tasksdb
DATABASE_URL=postgresql://tasks:tasks_password@localhost:5433/tasksdb

# SSL: "true" para Neon (obligatorio), "false" para el PostgreSQL local de Docker.
DB_SSL=false

# Puerto HTTP (Render inyecta su propio PORT automáticamente).
PORT=3000

# development | production
NODE_ENV=development
